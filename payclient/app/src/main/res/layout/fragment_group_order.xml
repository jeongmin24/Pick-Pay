<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_group_order_header"
        android:layout_width="0dp"
        android:layout_height="104dp"
        android:background="@drawable/bg_group_order_header"
        android:elevation="8dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar_group_order"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:background="@android:color/transparent"
            app:contentInsetStartWithNavigation="0dp"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="함께 주문하기"
            app:titleTextAppearance="@style/TextAppearance.Payclient.GroupOrderTitle"
            app:titleTextColor="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btn_toggle_header"
            android:layout_width="42dp"
            android:layout_height="30dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_group_header_toggle"
            android:contentDescription="공동 주문방 정보 펼치기"
            android:padding="6dp"
            android:rotation="180"
            android:scaleType="center"
            android:src="@drawable/ic_chevron_up"
            android:tint="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <LinearLayout
            android:id="@+id/layout_group_chips"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbar_group_order">

            <TextView
                android:id="@+id/tv_group_id_chip"
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_group_order_chip"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="ID: -"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_group_host_chip"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_group_order_chip"
                android:gravity="center"
                android:minWidth="48dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="참여자"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_group_status_chip"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:background="@drawable/bg_group_order_chip"
                android:gravity="center"
                android:minWidth="68dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="● OPEN"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_group_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="메뉴를 담으면 실시간으로 공유됩니다."
            android:textColor="@color/white"
            android:textSize="19sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_group_chips" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_group_menu_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="14dp"
        android:paddingTop="26dp"
        android:paddingEnd="14dp"
        android:paddingBottom="136dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_group_order_header" />

    <LinearLayout
        android:id="@+id/layout_group_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="22dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="end"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_share_link"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginBottom="14dp"
            android:contentDescription="초대 링크 공유"
            android:src="@drawable/ic_share_nodes"
            app:backgroundTint="@color/nav_selected_bg"
            app:elevation="4dp"
            app:fabCustomSize="52dp"
            app:tint="@color/coffee_brown" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_chat"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginBottom="14dp"
            android:contentDescription="채팅"
            android:src="@drawable/ic_chat_outline"
            app:backgroundTint="@color/nav_selected_bg"
            app:elevation="4dp"
            app:fabCustomSize="52dp"
            app:tint="@color/coffee_brown" />

        <FrameLayout
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_group_cart"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="bottom|start"
                android:contentDescription="공동 장바구니"
                android:src="@drawable/ic_cart_outline"
                app:backgroundTint="@color/coffee_brown"
                app:elevation="6dp"
                app:fabCustomSize="56dp"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tv_group_cart_badge"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_cart_badge"
                android:elevation="12dp"
                android:gravity="center"
                android:text="0"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:translationZ="12dp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
