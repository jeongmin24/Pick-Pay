<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_order_header"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_order_title_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_cup_line"
            app:tint="@color/coffee_brown"
            app:layout_constraintBottom_toBottomOf="@id/tv_order_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_order_title" />

        <TextView
            android:id="@+id/tv_order_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp"
            android:text="주문하기"
            android:textColor="@color/coffee_brown_dark"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/iv_order_search"
            app:layout_constraintStart_toEndOf="@id/iv_order_title_icon"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/iv_order_search"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="검색"
            android:padding="2dp"
            android:src="@drawable/ic_search"
            app:tint="@color/nav_unselected"
            app:layout_constraintBottom_toBottomOf="@id/tv_order_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_order_title" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_menu_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="120dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_order_header" />

    <FrameLayout
        android:id="@+id/cart_fab_container"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_personal_cart"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="bottom|start"
            android:contentDescription="장바구니"
            android:src="@drawable/ic_cart_outline"
            app:backgroundTint="@color/coffee_brown"
            app:elevation="5dp"
            app:fabCustomSize="52dp"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/tv_cart_badge"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_cart_badge"
            android:gravity="center"
            android:text="0"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/layout_group_fabs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="18dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="end"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fab_create_group"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginBottom="10dp"
            android:text="방 만들기"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:backgroundTint="@color/coffee_brown"
            app:icon="@drawable/person_add_24px"
            app:iconTint="@color/white" />

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fab_join_group"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginBottom="12dp"
            android:text="방 입장"
            android:textColor="@color/coffee_brown_dark"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:backgroundTint="@color/nav_selected_bg"
            app:icon="@drawable/ic_group_enter"
            app:iconTint="@color/coffee_brown" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_group_menu"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="같이 주문"
            android:src="@drawable/ic_group_order"
            app:backgroundTint="@color/nav_selected_bg"
            app:elevation="4dp"
            app:fabCustomSize="52dp"
            app:tint="@color/coffee_brown" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
