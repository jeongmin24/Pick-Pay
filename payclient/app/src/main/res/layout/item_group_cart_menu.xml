<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="72dp">

    <TextView
        android:id="@+id/tv_group_cart_menu_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/btn_group_cart_remove"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_group_cart_quantity"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="10dp"
        android:textColor="@color/coffee_brown"
        android:textSize="14sp"
        app:layout_constraintEnd_toStartOf="@id/btn_group_cart_remove"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_group_cart_menu_name" />

    <TextView
        android:id="@+id/tv_group_cart_item_total"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:ellipsize="end"
        android:gravity="end"
        android:maxLines="1"
        android:textColor="@color/coffee_brown"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/layout_quantity_controls"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/layout_quantity_controls"
        android:layout_width="108dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_quantity_stepper"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="4dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btn_group_cart_decrease"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_qty_button"
            android:gravity="center"
            android:text="-"
            android:textColor="@color/coffee_brown"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tv_group_cart_control_quantity"
            android:layout_width="40dp"
            android:layout_height="30dp"
            android:gravity="center"
            android:textColor="@color/coffee_brown_dark"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btn_group_cart_increase"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_qty_button"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/coffee_brown"
            android:textSize="18sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_group_cart_remove"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="삭제"
        android:padding="7dp"
        android:src="@drawable/ic_delete_outline"
        android:visibility="gone"
        app:tint="@color/coffee_brown_dark"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
